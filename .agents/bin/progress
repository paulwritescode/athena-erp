#!/usr/bin/env python3
"""Record a progress update and send it to Stylus.

  progress "<lanes, merges since last update, blockers, next>"

Adds the live agent list, suite-lock holder and resources to the entry in
.agents/stylus/progress.jsonl (the dashboard's Updates panel), then sends the
text to Stylus with say.
"""
import json, os, subprocess, sys
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import _stylus as s

if any(a in ("-h", "--help", "help") for a in sys.argv[1:2]):  # HELP_GUARD: never queue or send a help request
    print(__doc__.strip())
    sys.exit(0)


if len(sys.argv) < 2:
    sys.exit(__doc__)
text = " ".join(sys.argv[1:]).strip()
live = [{"name": t.get("name"), "status": t.get("status")} for t in s.terminals() if t.get("name")]
try:
    holder = json.load(open(s.path("locks/suite/owner.json"))).get("who")
except (FileNotFoundError, ValueError):
    holder = None
main = subprocess.run(["git", "--no-optional-locks", "rev-parse", "--short", "main"], cwd=s.ROOT, capture_output=True, text=True).stdout.strip()
s.append("progress.jsonl", {"by": s.me(), "text": text, "main": main, "agents": live, "suite": holder,
                            "memFreePct": s.mem_free_pct(), "diskFreeGB": round(s.disk_free_gb(), 1)})
here = os.path.dirname(os.path.abspath(__file__))
subprocess.run([os.path.join(here, "say"), "stylus", "UPDATE: " + text])
