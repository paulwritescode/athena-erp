#!/usr/bin/env python3
"""Every N minutes (limits.json updateEveryMinutes), ask master for its progress
update, and nudge agents that have been idle with no report for too long.
Run it in its own pane in the dashboard tab: python3 .agents/bin/ticker
"""
import os, subprocess, sys, time
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import _stylus as s

print("ticker: asks master for an update every", s.limits()["updateEveryMinutes"], "minutes (ctrl+c quits)")
while True:
    time.sleep(s.limits()["updateEveryMinutes"] * 60)
    names = [t.get("name") for t in s.terminals()]
    if "master" not in names:
        print(time.strftime("%H:%M"), "no master terminal; skipped")
        continue
    text = ("ORDER: 10-minute tick. Post your progress update now: run .agents/bin/progress, then "
            ".agents/bin/say stylus \"UPDATE: <lanes, merges, blockers, next>\". Check every agent you own "
            "(hc ls, hc read) and unstick any that is idle without a report.")
    subprocess.run(["hc", "send", "master", "TICKER→MASTER: " + text], capture_output=True)
    s.append("comms.jsonl", {"from": "ticker", "to": "master", "kind": "ORDER", "text": text, "delivered": True})
    print(time.strftime("%H:%M"), "asked master for an update")
