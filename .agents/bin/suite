#!/usr/bin/env python3
"""Run a heavy command (full suite, browser pass) at most `suiteSlots` at a time across all agents.

  suite [--label "C1 merge"] [--] make test        (default command: make test)
  suite stop <who>                                  end that agent's run (whole test tree) or wait

Waits for a free slot: .agents/stylus/locks/suite, then suite-1, suite-2 ... up to
`suiteSlots` in limits.json (default 1). Each slot holds one owner. Go test runs
(`make test`, `go test`, affected runs with Go packages) use only the first slot, so
one runs at a time; web-only and browser runs use the other slots, and the first
slot only when no Go run waits. A lock
whose owner process is gone is taken over. Every run is logged with its exit
status and duration in .agents/stylus/suite.jsonl; the output tail goes to
.agents/stylus/suite-logs/<time>-<who>.log.
"""
import glob, json, os, shutil, signal, subprocess, sys, threading, time
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import _stylus as s

if any(a in ("-h", "--help", "help") for a in sys.argv[1:2]):  # HELP_GUARD: never queue or send a help request
    print(__doc__.strip())
    sys.exit(0)

args = sys.argv[1:]
if args[:1] == ["stop"]:  # suite stop <who> : cleanly end that agent's run or queued wait
    if len(args) < 2:
        sys.exit("usage: suite stop <who>")
    target, hits = args[1], 0
    for d in sorted(glob.glob(s.path("locks/suite*"))) + [os.path.join(s.path("locks/queue"), f)
                                                       for f in os.listdir(s.path("locks/queue"))] \
            if os.path.isdir(s.path("locks/queue")) else sorted(glob.glob(s.path("locks/suite*"))):
        f = os.path.join(d, "owner.json") if os.path.isdir(d) else d
        try:
            o = json.load(open(f))
        except (FileNotFoundError, ValueError, OSError):
            continue
        if o.get("who") == target:
            try:
                os.kill(o["pid"], signal.SIGTERM)
                hits += 1
                print(f"suite: stopped {target} pid {o['pid']} ({o.get('label', '')})")
            except OSError:
                pass
    sys.exit(0 if hits else f"suite: nothing running or queued for {target}")
label = ""
if args[:1] == ["--label"]:
    label, args = args[1], args[2:]
if args[:1] == ["--"]:
    args = args[1:]
cmd = args or ["make", "test"]
def tree_state(where):
    head = subprocess.run(["git", "--no-optional-locks", "rev-parse", "--short", "HEAD"], cwd=where, capture_output=True, text=True).stdout.strip()
    dirty = subprocess.run(["git", "--no-optional-locks", "status", "--porcelain", "--untracked-files=no"], cwd=where,
                           capture_output=True, text=True).stdout.strip()
    return head, not dirty


lock = s.path("locks/suite")
os.makedirs(os.path.dirname(lock), exist_ok=True)
os.makedirs(s.path("suite-logs"), exist_ok=True)
who, cwd = s.me(), os.getcwd()
head, clean = tree_state(cwd)
if clean and os.environ.get("SUITE_FORCE") != "1":
    prior = [r for r in s.read_jsonl("suite.jsonl") if r.get("event") == "end" and r.get("head") == head
             and r.get("clean") and r.get("cmd") == " ".join(cmd) and r.get("exit") == 0]
    if prior:
        r = prior[-1]
        print(f"suite: {' '.join(cmd)} already green on {head} (clean tree) by {r['who']} at {r['ts']}, "
              f"log {r['log']}; not rerun. SUITE_FORCE=1 reruns.")
        s.append("suite.jsonl", {"event": "reused", "who": who, "cwd": cwd, "cmd": " ".join(cmd), "label": label,
                                 "head": head, "from": r["log"]})
        sys.exit(0)


def alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


# Ordered queue: master's merge gate first, then everyone else in arrival order.
# Each waiter keeps a ticket in locks/queue/<pid>.json; dead waiters are dropped.
qdir = s.path("locks/queue")
os.makedirs(qdir, exist_ok=True)
ticket = os.path.join(qdir, f"{os.getpid()}.json")
prio = 0 if who == "master" else 1
def is_full(c, lab):
    # Go test runs (full `make test` or scoped `go test` of the big packages) each use most of the
    # machine: two at once pushed internal/server and internal/posting past their 20 minute timeout.
    lab = lab or ""
    return "make test" in c or "go test" in c or lab.startswith("affected: full") or \
        (lab.startswith("affected: Go:") and not lab.startswith("affected: Go: none"))


FULL = is_full(" ".join(cmd), label)
json.dump({"pid": os.getpid(), "who": who, "label": label, "prio": prio, "t": time.time(), "full": FULL,
           "cmd": " ".join(cmd)}, open(ticket, "w"))
for sig in (signal.SIGTERM, signal.SIGHUP):
    signal.signal(sig, lambda *_: sys.exit(143))


def first_in_line():
    tickets = []
    for f in os.listdir(qdir):
        try:
            t = json.load(open(os.path.join(qdir, f)))
        except (ValueError, OSError):
            continue
        if alive(t["pid"]):
            tickets.append(t)
        else:
            try:
                os.remove(os.path.join(qdir, f))
            except OSError:
                pass
    tickets.sort(key=lambda t: (t["prio"], t["t"]))
    full = lambda t: t.get("full", is_full(t.get("cmd", ""), t.get("label")))
    if FULL:  # one full run at a time, on the first slot only
        mine = [t for t in tickets if full(t)]
        if any(heavy_owner(d) for d in slot_dirs):  # a Go run already holds some slot
            return False
        return (not mine or mine[0]["pid"] == os.getpid()) and not os.path.isdir(slot_dirs[0])
    mine = [t for t in tickets if not full(t)]
    ahead = next((i for i, t in enumerate(mine) if t["pid"] == os.getpid()), 0)
    return ahead < free_slots()


SLOTS = max(1, int(s.limits().get("suiteSlots", 1)))
slot_dirs = [lock] + [s.path(f"locks/suite-{i}") for i in range(1, SLOTS)]


def heavy_owner(d):
    try:
        o = json.load(open(os.path.join(d, "owner.json")))
    except (FileNotFoundError, ValueError, OSError):
        return False
    return alive(o.get("pid", 0)) and is_full(o.get("cmd", ""), o.get("label"))


def free_slots():
    return sum(not os.path.isdir(d) for d in slot_dirs)


waited = time.time()
s.append("suite.jsonl", {"event": "queued", "who": who, "cwd": cwd, "cmd": " ".join(cmd), "label": label,
                         "pid": os.getpid()})
try:
    while True:
        got = None
        if first_in_line():
            full_waiting = False
            for f in os.listdir(qdir):
                try:
                    t = json.load(open(os.path.join(qdir, f)))
                except (ValueError, OSError):
                    continue
                if f != os.path.basename(ticket) and alive(t.get("pid", 0)) and \
                        t.get("full", is_full(t.get("cmd", ""), t.get("label"))):
                    full_waiting = True
            order = slot_dirs[:1] if FULL else (slot_dirs[1:] + ([] if full_waiting else slot_dirs[:1]))
            for d in order:
                try:
                    os.mkdir(d)
                    got = d
                    break
                except FileExistsError:
                    pass
        if got:
            lock = got
            break
        for d in slot_dirs:
            try:
                owner = json.load(open(os.path.join(d, "owner.json")))
                if not alive(owner["pid"]):
                    os.remove(os.path.join(d, "owner.json"))
                    os.rmdir(d)
                    s.append("suite.jsonl", {"event": "stale", "who": owner.get("who"), "pid": owner["pid"]})
            except (FileNotFoundError, ValueError, KeyError):
                try:
                    if time.time() - os.path.getmtime(d) > 60:
                        os.rmdir(d)
                except OSError:
                    pass
        time.sleep(3)
except BaseException:
    s.append("suite.jsonl", {"event": "gave-up", "who": who, "cwd": cwd, "cmd": " ".join(cmd), "label": label})
    raise
finally:
    try:
        os.remove(ticket)
    except OSError:
        pass

json.dump({"pid": os.getpid(), "who": who, "cwd": cwd, "cmd": " ".join(cmd), "label": label,
           "slot": os.path.basename(lock), "since": s.now()}, open(os.path.join(lock, "owner.json"), "w"))
start = time.time()
s.append("suite.jsonl", {"event": "start", "who": who, "cwd": cwd, "cmd": " ".join(cmd), "label": label,
                         "waited_s": int(start - waited)})
logf = s.path(f"suite-logs/{time.strftime('%m%d-%H%M%S')}-{who}.log")
code = 1
proc = None
stopped = None  # set when a signal or the time limit ends the run


def kill_tree(p):
    """End the whole test tree: the child runs in its own session, so killing only suite would orphan it."""
    try:
        os.killpg(p.pid, signal.SIGTERM)
    except OSError:
        return
    try:
        p.wait(timeout=15)
    except subprocess.TimeoutExpired:
        try:
            os.killpg(p.pid, signal.SIGKILL)
        except OSError:
            pass


try:
    with open(logf, "w") as log:
        env = dict(os.environ)
        if not shutil.which("node", path=env.get("PATH")):  # agent shells often miss nvm's node
            nvm = sorted(glob.glob(os.path.expanduser("~/.nvm/versions/node/*/bin")))
            if nvm:
                env["PATH"] = nvm[-1] + os.pathsep + env.get("PATH", "")
                log.write(f"suite: node not on PATH, using {nvm[-1]}\n")
        proc = subprocess.Popen(cmd, cwd=cwd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
                                start_new_session=True, env=env)
        lim = s.limits()
        limit = (lim.get("suiteTimeoutMinutes", 30) if FULL else lim.get("browserTimeoutMinutes", 15)) * 60

        def watchdog():  # fires even when the run prints nothing (a hung browser driver used to hold a slot for an hour)
            nonlocal_stop[0] = f"time limit {limit // 60} minutes"
            kill_tree(proc)

        nonlocal_stop = [None]
        timer = threading.Timer(limit, watchdog)
        timer.daemon = True
        timer.start()
        try:
            for line in proc.stdout:
                sys.stdout.write(line)
                log.write(line)
            code = proc.wait()
            timer.cancel()
            if nonlocal_stop[0]:
                stopped = nonlocal_stop[0]
                log.write(f"\nsuite: stopped after {limit // 60} minutes; test tree ended\n")
        except BaseException as e:  # SIGTERM/SIGHUP (sys.exit 143) or ctrl+c while the tests run
            stopped = "signal" if isinstance(e, SystemExit) else type(e).__name__
            log.write(f"\nsuite: stopped by {stopped}; test tree ended\n")
            kill_tree(proc)
            code = 143
finally:
    if proc is not None and proc.poll() is None:
        kill_tree(proc)
    try:
        os.remove(os.path.join(lock, "owner.json"))
        os.rmdir(lock)
    except OSError:
        pass
    rec = {"who": who, "cwd": cwd, "cmd": " ".join(cmd), "label": label, "secs": int(time.time() - start),
           "log": os.path.basename(logf), "head": head}
    if stopped:  # not a test result: never reusable, never read as red
        s.append("suite.jsonl", {"event": "stopped", "reason": stopped, **rec})
    else:
        s.append("suite.jsonl", {"event": "end", "exit": code, "clean": clean and tree_state(cwd) == (head, True), **rec})
sys.exit(code)
